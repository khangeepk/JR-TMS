# ─────────────────────────────────────────────────────────────────────────
# JR Arcade TMS — environment variables
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Prisma + Supabase Postgres) ───────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
# Direct (non-pooled) connection used by prisma migrate / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ── Auth (NextAuth) ─────────────────────────────────────────────────────
NEXTAUTH_SECRET="GENERATE_A_STRONG_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ── Supabase Storage (ledger backups) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SECRET"

# ── Application timezone ─────────────────────────────────────────────────
APP_TIMEZONE=Asia/Karachi

# ── WhatsApp provider (Meta WhatsApp Cloud API) ─────────────────────────
# Credentials are read ONLY from the environment — never hardcoded in source.
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Set the Graph API version you have access to (e.g. v21.0).
WHATSAPP_API_VERSION=CONFIGURE_IN_DEPLOYMENT
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_SECRET
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_SECRET
WHATSAPP_TEMPLATE_NAME=rent_due_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ── Rent reminder automation ─────────────────────────────────────────────
RENT_REMINDER_ENABLED=true
RENT_REMINDER_DAY=5
RENT_REMINDER_HOUR=10
RENT_REMINDER_TIMEZONE=Asia/Karachi

# ── Cron protection ──────────────────────────────────────────────────────
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=GENERATE_A_STRONG_SECRET
# Legacy server-to-server token (optional; kept for backwards compatibility).
# AUTH_TOKEN=
