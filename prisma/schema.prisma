generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TenantProfile {
  id                   Int                    @id @default(autoincrement())
  name                 String
  phone                String
  monthlyRent          Float
  waterCharges         Float                  @default(0)
  offices              String[]               @default([])
  isShared             Boolean                @default(false)
  startDate            DateTime               @default(now())
  rentStatus           String                 @default("unpaid")
  waterStatus          String                 @default("unpaid")
  // Security Deposit Fields
  totalSecurityAmount  Float                  @default(0)
  securityPaidSoFar    Float                  @default(0)
  securityStatus       String                 @default("Pending") // "Pending", "Partial", "Fully Paid"
  // Notification / lifecycle fields (used by automated WhatsApp reminders)
  isActive             Boolean                @default(true)
  whatsappOptIn        Boolean                @default(true)
  doNotContact         Boolean                @default(false)
  // Optional explicit WhatsApp number. When null the primary `phone` is normalized instead.
  // The original `phone` value is never overwritten by the reminder system.
  whatsappNumber       String?
  payments             PaymentRecord[]
  securityInstallments SecurityInstallment[]
  reminderLogs         RentReminderLog[]
}

model PaymentRecord {
  id        Int           @id @default(autoincrement())
  receiptId String        @unique @default(cuid())
  amount    Float
  type      String        @default("RENT") // "RENT", "WATER", "SECURITY"
  date      DateTime      @default(now())
  month     String
  tenantId  Int
  tenant    TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SecurityInstallment {
  id          Int           @id @default(autoincrement())
  receiptId   String        @unique @default(cuid())
  amount      Float
  paymentDate DateTime      @default(now())
  tenantId    Int
  tenant      TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   // "Utility Bills" | "Maintenance & Repairing" | "Misc Charges"
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model PropertyInfo {
  id           Int    @id @default(1)
  propertyName String @default("JR Arcade")
  phone        String @default("")
  email        String @default("")
  address      String @default("")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  canEdit      Boolean  @default(false)
  canAdd       Boolean  @default(false)
  canDelete    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

/// Audit + idempotency log for outbound WhatsApp reminders.
/// A row is created (status = "pending") BEFORE any provider call so that the
/// unique constraint prevents duplicate reminders for the same billing period,
/// even if the cron job runs twice concurrently.
model RentReminderLog {
  id                Int           @id @default(autoincrement())
  tenantId          Int
  tenant            TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // No separate lease model exists; leaseId mirrors tenantId so the composite
  // unique key stays fully non-null and reliable in Postgres.
  leaseId           Int
  propertyId        Int           @default(1)
  billingPeriod     String        // Canonical "YYYY-MM" in Asia/Karachi
  reminderType      String        @default("RENT_DUE") // RENT_DUE | TEST
  phoneNumberMasked String        @default("")
  provider          String        @default("")
  providerMessageId String?
  templateName      String        @default("")
  status            String        @default("pending") // pending | sent | failed | skipped
  attemptCount      Int           @default(0)
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, leaseId, billingPeriod, reminderType])
  @@index([billingPeriod])
  @@index([status])
}

/// Singleton (id = 1) holding automation configuration for rent reminders.
/// Secrets (tokens, phone number id) are NEVER stored here — only in env vars.
model NotificationSettings {
  id                  Int      @id @default(1)
  enabled             Boolean  @default(true)
  reminderDay         Int      @default(5)
  reminderHour        Int      @default(10)
  timezone            String   @default("Asia/Karachi")
  templateName        String   @default("rent_due_reminder")
  templateLanguage    String   @default("en_US")
  paymentInstructions String   @default("")
  supportContact      String   @default("")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}
